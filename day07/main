#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

#define SIZE 5

// 함수 선언
void initMaze(char maze[SIZE][SIZE]);
void printMaze(char maze[SIZE][SIZE]);
int canEscape(char maze[SIZE][SIZE], int visited[SIZE][SIZE], int row, int col);

// 메인 함수
int main()
{
    // 미로를 저장할 2차원 배열
    char maze[SIZE][SIZE];

    // 방문한 칸을 저장하는 배열
    // 0 : 아직 방문 안 함
    // 1 : 이미 방문함
    int visited[SIZE][SIZE] = { 0 };

    // 미로 초기화
    initMaze(maze);

    // 미로 출력
    printf("현재 미로\n");
    printMaze(maze);

    // 시작 위치(S)의 좌표
    int startRow = 1;
    int startCol = 1;

    // DFS를 이용하여 탈출 가능한지 확인
    if (canEscape(maze, visited, startRow, startCol))
    {
        printf("\n도착 지점(E)까지 갈 수 있습니다.\n");
    }
    else
    {
        printf("\n도착 지점(E)까지 갈 수 없습니다.\n");
    }

    return 0;
}

// 미로 초기화
void initMaze(char maze[SIZE][SIZE])
{
    // 미리 만들어 둔 미로
    char temp[SIZE][SIZE] =
    {
        {'#','#','#','#','#'},
        {'#','S',' ',' ','#'},
        {'#',' ','#',' ','#'},
        {'#',' ',' ','E','#'},
        {'#','#','#','#','#'}
    };

    // temp 배열의 값을 maze 배열로 복사
    for (int i = 0; i < SIZE; i++)
    {
        for (int j = 0; j < SIZE; j++)
        {
            maze[i][j] = temp[i][j];
        }
    }
}

// 미로 출력
void printMaze(char maze[SIZE][SIZE])
{
    // 한 줄씩 출력
    for (int i = 0; i < SIZE; i++)
    {
        for (int j = 0; j < SIZE; j++)
        {
            printf("%c ", maze[i][j]);
        }

        printf("\n");
    }
}

// DFS 함수
int canEscape(char maze[SIZE][SIZE], int visited[SIZE][SIZE], int row, int col)
{
    // 1. 미로 밖으로 나갔으면 실패
    if (row < 0 || row >= SIZE || col < 0 || col >= SIZE)
    {
        return 0;
    }

    // 2. 벽이면 갈 수 없음
    if (maze[row][col] == '#')
    {
        return 0;
    }
    
    // 3. 이미 방문한 칸이면
    // 다시 방문하지 않음
    if (visited[row][col] == 1)
    {
        return 0;
    }

    // 4. 도착 지점이면 성공
    if (maze[row][col] == 'E')
    {
        return 1;
    }

 
    // 5. 현재 위치를 방문했다고 표시
     visited[row][col] = 1;
    
    // 6. 상, 하, 좌, 우 순서대로
    // 재귀 호출
    // 하나라도 성공하면 성공

    // 위
    if (canEscape(maze, visited, row - 1, col))
    {
        return 1;
    }

    // 아래
    if (canEscape(maze, visited, row + 1, col))
    {
        return 1;
    }

    // 왼쪽
    if (canEscape(maze, visited, row, col - 1))
    {
        return 1;
    }

    // 오른쪽
    if (canEscape(maze, visited, row, col + 1))
    {
        return 1;
    }

    // 7. 네 방향 모두 실패하면
    // 갈 수 없는 길이므로 실패 반환
    // (재귀가 이전 호출로 되돌아감)
    return 0;
}
