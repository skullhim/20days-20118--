#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdbool.h>

#define MAX 10

// 미로를 파일에서 읽어오는 함수
bool readMazeFromFile(char filename[], char maze[MAX][MAX], int* row, int* col)
{
    // 파일 포인터 선언
    FILE* fp;

    // 파일 열기 (읽기 모드)
    fp = fopen(filename, "r");

    // 파일을 열지 못한 경우
    if (fp == NULL)
    {
        printf("파일을 열 수 없습니다.\n");
        return false;
    }

    // 첫 줄에서 행과 열의 크기를 읽음
    fscanf(fp, "%d %d", row, col);

    // 미로 데이터를 한 줄씩 읽음
    for (int i = 0; i < *row; i++)
    {
        // 문자열 형태로 한 줄을 읽어 배열에 저장
        fscanf(fp, "%s", maze[i]);
    }

    // 파일 사용이 끝났으므로 반드시 닫아야 함
    fclose(fp);

    // 성공적으로 읽었음을 반환
    return true;
}

int main()
{
    // 미로를 저장할 2차원 배열
    char maze[MAX][MAX];

    // 행과 열의 크기
    int row, col;

    // 파일 이름
    char filename[] = "maze.txt";

    // 파일 읽기 함수 호출
    if (readMazeFromFile(filename, maze, &row, &col))
    {
        printf("미로 읽기 성공!\n\n");

        // 저장된 미로 출력
        for (int i = 0; i < row; i++)
        {
            printf("%s\n", maze[i]);
        }
    }
    else
    {
        printf("미로 읽기 실패!\n");
    }

    return 0;
}
