#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

#define SIZE 5

// 함수 선언
void initMaze(char maze[SIZE][SIZE]);
void printMaze(char maze[SIZE][SIZE]);
int movePlayer(char maze[SIZE][SIZE], int* row, int* col, char direction);
int isGoal(char maze[SIZE][SIZE], int row, int col);

// 메인 함수
int main()
{
    // 미로를 저장할 2차원 배열
    char maze[SIZE][SIZE];

    // 플레이어의 현재 위치
    int row = 1;
    int col = 1;

    // 이동 방향을 입력받을 변수
    char direction;

    // 미로 초기화
    initMaze(maze);

    while (1)
    {
        // 현재 미로 출력
        printMaze(maze);

        // 도착했는지 확인
        if (isGoal(maze, row, col))
        {
            printf("도착했습니다!\n");
            break;
        }

        // 이동 방향 입력
        printf("이동(W:위 S:아래 A:왼쪽 D:오른쪽) : ");
        scanf(" %c", &direction);

        // 플레이어 이동
        if (!movePlayer(maze, &row, &col, direction))
        {
            printf("이동할 수 없는 곳입니다.\n");
        }
    }

    return 0;
}

// 미로 초기화
void initMaze(char maze[SIZE][SIZE])
{
    // 미로의 모양을 미리 저장
    char temp[SIZE][SIZE] =
    {
        {'#','#','#','#','#'},
        {'#','S',' ',' ','#'},
        {'#',' ','#',' ','#'},
        {'#',' ',' ','E','#'},
        {'#','#','#','#','#'}
    };

    // temp 배열의 내용을 maze 배열로 복사
    for (int i = 0; i < SIZE; i++)
    {
        for (int j = 0; j < SIZE; j++)
        {
            maze[i][j] = temp[i][j];
        }
    }
}

// 미로 출력
void printMaze(char maze[SIZE][SIZE])
{
    printf("\n");

    // 미로를 한 줄씩 출력
    for (int i = 0; i < SIZE; i++)
    {
        for (int j = 0; j < SIZE; j++)
        {
            printf("%c ", maze[i][j]);
        }

        printf("\n");
    }

    printf("\n");
}

// 플레이어 이동
int movePlayer(char maze[SIZE][SIZE], int* row, int* col, char direction)
{
    // 이동할 위치를 현재 위치로 초기화
    int newRow = *row;
    int newCol = *col;

    // 방향에 따라 이동 좌표 변경
    switch (direction)
    {
    case 'W':
    case 'w':
        newRow--;
        break;

    case 'S':
    case 's':
        newRow++;
        break;

    case 'A':
    case 'a':
        newCol--;
        break;

    case 'D':
    case 'd':
        newCol++;
        break;

    default:
        return 0;
    }

    // 벽이면 이동 실패
    if (maze[newRow][newCol] == '#')
    {
        return 0;
    }

    // 시작 위치는 길로 변경
    if (maze[*row][*col] != 'S')
    {
        maze[*row][*col] = ' ';
    }

    // 현재 위치 저장
    *row = newRow;
    *col = newCol;

    // 도착 지점이 아니면 플레이어 표시
    if (maze[newRow][newCol] != 'E')
    {
        maze[newRow][newCol] = 'P';
    }

    return 1;
}

// 도착 확인
int isGoal(char maze[SIZE][SIZE], int row, int col)
{
    // 현재 위치가 도착 지점이면 성공
    if (maze[row][col] == 'E')
    {
        return 1;
    }

    return 0;
}
