#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>     // malloc(), free() 사용

// 합과 평균을 계산하는 함수
// arr : 동적 배열의 시작 주소
// size : 배열의 크기(N)
// sum : 합을 저장할 변수의 주소
// avg : 평균을 저장할 변수의 주소
void calculate(int* arr, int size, int* sum, double* avg)
{
    // 합 초기화
    *sum = 0;

    // 배열의 모든 값을 더함
    for (int i = 0; i < size; i++)
    {
        *sum += arr[i];
    }

    // 평균 계산
    *avg = (double)(*sum) / size;
}

int main()
{
    // 입력받을 배열의 크기
    int N;

    // 동적 배열을 가리킬 포인터
    int* arr;

    // 합과 평균을 저장할 변수
    int sum;
    double avg;

    // 배열 크기 입력
    printf("배열의 크기를 입력하세요 : ");
    scanf("%d", &N);

    // N이 0 이하이면 종료
    if (N <= 0)
    {
        printf("배열의 크기는 1 이상이어야 합니다.\n");
        return 0;
    }

    // N개의 정수를 저장할 메모리 동적 할당
    arr = (int*)malloc(sizeof(int) * N);

    // malloc 실패 확인
    if (arr == NULL)
    {
        printf("메모리 할당에 실패했습니다.\n");
        return 0;
    }

    // 배열 값 입력
    printf("%d개의 정수를 입력하세요.\n", N);

    for (int i = 0; i < N; i++)
    {
        printf("%d번째 정수 : ", i + 1);
        scanf("%d", &arr[i]);
    }

    // 합과 평균 계산 함수 호출
    calculate(arr, N, &sum, &avg);

    // 결과 출력
    printf("\n합 : %d\n", sum);
    printf("평균 : %.2lf\n", avg);

    // 동적으로 할당한 메모리 해제
    free(arr);

    // 해제 후에는 NULL을 넣어 실수로 접근하지 않도록 함
    arr = NULL;

    return 0;
}
